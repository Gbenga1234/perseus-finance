# Copy to .env and fill in, or generate everything with:  make secrets
# .env is git-ignored. Never commit real values.

POSTGRES_PASSWORD=<random, at least 32 characters>
REDIS_PASSWORD=<random, at least 32 characters>
EVENT_SIGNING_KEY=<random, at least 32 characters>
MFA_ENCRYPTION_KEY=<Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'>
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_DB_MIGRATOR_PASSWORD=<random, at least 32 characters>
AUTH_DB_APP_PASSWORD=<random, at least 32 characters>
ACCOUNTS_DB_MIGRATOR_PASSWORD=<random, at least 32 characters>
ACCOUNTS_DB_APP_PASSWORD=<random, at least 32 characters>
LEDGER_DB_MIGRATOR_PASSWORD=<random, at least 32 characters>
LEDGER_DB_APP_PASSWORD=<random, at least 32 characters>
FRAUD_DB_MIGRATOR_PASSWORD=<random, at least 32 characters>
FRAUD_DB_APP_PASSWORD=<random, at least 32 characters>
NOTIFICATIONS_DB_MIGRATOR_PASSWORD=<random, at least 32 characters>
NOTIFICATIONS_DB_APP_PASSWORD=<random, at least 32 characters>
AUDIT_DB_MIGRATOR_PASSWORD=<random, at least 32 characters>
AUDIT_DB_APP_PASSWORD=<random, at least 32 characters>
LEDGER_CLIENT_SECRET=<random, at least 32 characters>
ACCOUNTS_CLIENT_SECRET=<random, at least 32 characters>
SERVICE_CLIENTS='{"ledger-service":{"secret_sha256":"<sha256 of LEDGER_CLIENT_SECRET>","scopes":["accounts:read","fraud:assess"]},"accounts-service":{"secret_sha256":"<sha256 of ACCOUNTS_CLIENT_SECRET>","scopes":["ledger:balance:read"]}}'
TLS_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
TLS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
