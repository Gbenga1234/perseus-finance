# Copy to .env and fill in, or generate a local-development .env with:  make secrets
# .env is git-ignored. Never commit real values.

# --- Deployment settings (production values shown) ---
ENVIRONMENT='production'
DOMAIN='api.example.com'                 # must match the certbot certificate name
GATEWAY_BIND='0.0.0.0'                   # 127.0.0.1 for local development
HTTP_PORT='80'                           # port 80 must be public for certbot HTTP-01
HTTPS_PORT='443'
LETSENCRYPT_DIR='/etc/letsencrypt'       # certbot's config dir on the host
CERTBOT_WEBROOT='/var/www/certbot'       # certbot --webroot path on the host
SMTP_HOST='smtp.your-provider.com'
SMTP_PORT='587'
SMTP_STARTTLS='true'                     # required in production
SMTP_USERNAME='<smtp user>'
SMTP_PASSWORD='<smtp password>'
MAIL_FROM='Perseus Finance <no-reply@example.com>'

# --- Secrets (random, at least 32 characters unless noted) ---
POSTGRES_PASSWORD='<random>'
REDIS_PASSWORD='<random>'
EVENT_SIGNING_KEY='<random>'
MFA_ENCRYPTION_KEY='<Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">'
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...RSA 3072...\n-----END PRIVATE KEY-----"
AUTH_DB_MIGRATOR_PASSWORD='<random>'
AUTH_DB_APP_PASSWORD='<random>'
ACCOUNTS_DB_MIGRATOR_PASSWORD='<random>'
ACCOUNTS_DB_APP_PASSWORD='<random>'
LEDGER_DB_MIGRATOR_PASSWORD='<random>'
LEDGER_DB_APP_PASSWORD='<random>'
FRAUD_DB_MIGRATOR_PASSWORD='<random>'
FRAUD_DB_APP_PASSWORD='<random>'
NOTIFICATIONS_DB_MIGRATOR_PASSWORD='<random>'
NOTIFICATIONS_DB_APP_PASSWORD='<random>'
AUDIT_DB_MIGRATOR_PASSWORD='<random>'
AUDIT_DB_APP_PASSWORD='<random>'
LEDGER_CLIENT_SECRET='<random>'
ACCOUNTS_CLIENT_SECRET='<random>'
SERVICE_CLIENTS='{"ledger-service":{"secret_sha256":"<sha256 of LEDGER_CLIENT_SECRET>","scopes":["accounts:read","fraud:assess"]},"accounts-service":{"secret_sha256":"<sha256 of ACCOUNTS_CLIENT_SECRET>","scopes":["ledger:balance:read"]}}'
